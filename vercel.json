{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/fund", "destination": "/api/fund" },
    { "source": "/api/holding", "destination": "/api/holding" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
